{
  "name": "cursor-claude-link",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Use local Claude Code subscription models in the Cursor agent harness on macOS 26+ (Apple Silicon)",
  "scripts": {
    "doctor": "node doctor.mjs",
    "test": "node --test test.mjs bridge.test.mjs attachments.test.mjs token-usage.test.mjs subagent-bubbles.test.mjs autostart.test.mjs macos.test.mjs build-support.test.mjs subagent-settings.test.mjs subagent-lifecycle.test.mjs conversation-actions.test.mjs",
    "test:live": "node live-test.mjs",
    "install:patch": "node patcher.mjs install",
    "uninstall": "node patcher.mjs restore",
    "restore": "node patcher.mjs restore",
    "start": "node bridge.mjs",
    "check": "node patcher.mjs check",
    "status": "node patcher.mjs status",
    "install-patch": "node patcher.mjs install",
    "check:source": "node scripts/check-source.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "test:attachments": "node scripts/test-attachments.mjs",
    "check:subagents": "node scripts/check-subagents.mjs",
    "check:actions": "node scripts/check-conversation-actions.mjs",
    "check:ui": "node scripts/check-ui.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Artic0din/cursor-claude-link.git"
  },
  "bugs": {
    "url": "https://github.com/Artic0din/cursor-claude-link/issues"
  }
}
